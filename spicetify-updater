#!/bin/bash
#
# spicetify-updater: re-applies Spicetify after Spotify updates iteself

set -euo pipefail

readonly EX_OK=0 \
    EX_PREFLIGHT=1 \
    EX_CLI_UPDATE=2 \
    EX_APPLY=3 \
    EX_VERIFY=4 \
    EX_LOCKED=5 \
    EX_ACTION_NEEDED=10 \
    EX_USAGE=64

# Prints the directory this script lives in. Follows symlinks so a linked
# install (e.g. in $(brew --prefix)/bin) still finds lib/.
resolve_root() {
    local path dir
    path="${BASH_SOURCE[0]}"
    while [ -L "$path" ]; do
        dir="$(cd -P "$(dirname "$path")" && pwd)"
        path="$(readlink "$path")"
        case "$path" in
            /*) ;;
            *) path="$dir/$path" ;;
        esac
    done
    cd -P "$(dirname "$path")" && pwd
}

SU_ROOT="$(resolve_root)"

# Load every module in lib/. Modules are used to only define functions and constants,
# so the order they load in doesn't matter
for lib in "$SU_ROOT"/lib/*.sh; do
    [ -f "$lib" ] || continue
    # shellcheck source=/dev/null
    . "$lib"
done
unset lib

# Settings. Flags in parse_args override these defaults
COMMAND=""
VERBOSITY=1 # 0 = quiet, 1 = normal, 2 = verbose
DRY_RUN=0
NO_RELAUNCH=0

usage() {
    cat <<'EOF'
Usage: spicetify-updater [command] [options]

Re-applies Spicetify after Spotify updates itself.

Commands:
    run             Re-patch Spotify if needed (default)
    status          Show the current state without changing anything

Options:
    -q              Quiet: only print warnings and errors
    -v              Verbose: print extra detail
    --dry-run       Show what would happen without doing it
    --no-relaunch   Don't reopen Spotify after patching
    -h, --help      Show this help and exit
EOF
}

# Prints an error and the usage text to stderr, then exits with EX_USAGE
usage_error() {
    log_error "$1"
    usage >&2
    exit "$EX_USAGE"
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -h | --help)
                usage
                exit "$EX_OK"
                ;;
            -q) VERBOSITY=0 ;;
            -v) VERBOSITY=2 ;;
            --dry-run) DRY_RUN=1 ;;
            --no-relaunch) NO_RELAUNCH=1 ;;
            run | status)
                if [ -n "$COMMAND" ]; then
                    usage_error "only one command allowed (got '$COMMAND' and '$1')"
                fi
                COMMAND="$1"
                ;;
            -*) usage_error "unknown option '$1'" ;;
            *) usage_error "unknown command '$1'" ;;
        esac
        shift
    done
    COMMAND="${COMMAND:-run}"
}

# Logs an error and exits (default code: EX_PREFLIGHT)
die() {
    log_error "$1"
    exit "${2:-$EX_PREFLIGHT}"
}

require_macos() {
    local os
    os="$(uname -s)"
    if [ "$os" != "Darwin" ]; then
        die "spicetify-updater only supports macOS (detected: $os)"
    fi
}

cmd_run() {
    log_info "run: not implemented yet"
}

# one "label value" line of the status summary
status_field() {
    log_info "$(printf '%-12s %s' "$1" "$2")"
}

cmd_status() {
    local bin cli spotify backup with theme scheme extensions apps patched state
    bin="$(detect_spicetify_bin)" || bin=""
    cli="$(detect_cli_version)" || cli=""
    spotify="$(detect_spotify_version)" || spotify=""
    backup="$(detect_backup_version)" || backup=""
    with="$(detect_backup_with)" || with=""
    theme="$(detect_theme)" || theme=""
    scheme="$(detect_color_scheme)" || scheme=""
    extensions="$(detect_extensions)" || extensions=""
    apps="$(detect_custom_apps)" || apps=""
    patched=0
    if detect_patch_present; then
        patched=1
    fi

    status_field "Spicetify" "${cli:-not found}${bin:+ ($bin)}"
    status_field "Spotify" "${spotify:-not found}"
    if [ -n "$backup" ] && [ -n "$with" ]; then
        status_field "Backup" "$backup (made with Spicetify $with)"
    else
        status_field "Backup" "${backup:-none}"
    fi
    if [ "$patched" -eq 1 ]; then
        status_field "Patch" "present"
    else
        status_field "Patch" "missing"
    fi
    status_field "Theme" "${theme:-none}${scheme:+ ($scheme)}"
    extensions="${extensions//|/, }"
    apps="${apps//|/, }"
    status_field "Extensions" "${extensions:-none}"
    status_field "Custom apps" "${apps:-none}"
    log_info ""

    if [ -z "$spotify" ]; then
        die "Spotify not found; is it installed?"
    fi
    if [ -z "$bin" ]; then
        die "spicetify not found on PATH"
    fi

    state="$(detect_state "$spotify" "$backup" "$patched")"
    case "$state" in
        up_to_date)
            log_verdict 32 "✓" "up to date"
            exit "$EX_OK"
            ;;
        spotify_updated) log_verdict 33 "⚠" "Spotify updated, re-patch needed" ;;
        patch_missing) log_verdict 33 "⚠" "patch missing" ;;
        no_backup) log_verdict 33 "⚠" "no Spicetify backup yet, re-patch needed" ;;
    esac
    exit "$EX_ACTION_NEEDED"
}

main() {
    parse_args "$@"
    require_macos
    log_init "$@"
    log_debug "command=$COMMAND dry_run=$DRY_RUN no_relaunch=$NO_RELAUNCH"
    case "$COMMAND" in
        run) cmd_run ;;
        status) cmd_status ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
